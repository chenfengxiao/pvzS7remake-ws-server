{
  "name": "pvz-s7-modular-dev",
  "private": true,
  "type": "module",
  "version": "1.2.4",
  "scripts": {
    "start": "node server/server.js",
    "dev": "vite --host 0.0.0.0",
    "verify": "python3 tools/verify_project.py",
    "build:fast": "python3 tools/build_fast_entry.py",
    "validate:fast": "python3 tools/validate_fast_entry.py",
    "build:single": "python3 tools/build_singlefile.py",
    "validate:single": "python3 tools/validate_singlefile.py",
    "release": "python3 tools/verify_project.py && python3 tools/build_fast_entry.py && python3 tools/validate_fast_entry.py",
    "release:single": "python3 tools/verify_project.py && python3 tools/build_singlefile.py && python3 tools/validate_singlefile.py",
    "test:experience": "node tools/test_experience_transmission.js",
    "test:cold": "node tools/test_cold_action_clock.js",
    "test:feature": "python3 tools/test_sniper_garg_cold_firelotus.py",
    "test:invariants": "python3 tools/test_spawn_cap_invariants.py",
    "test:critical": "python3 tools/test_critical_split.py",
    "test:versus-cooldown": "node tools/test_versus_card_cooldowns.js",
    "test:versus-bp": "node tools/test_versus_bp_draft.js",
    "test:versus-balance-format": "node tools/test_versus_balance_format.js",
    "test:versus-balance-telemetry": "node tools/test_versus_balance_telemetry.js",
    "test:versus-balance-analyzer": "python3 tools/test_versus_balance_analyzer.py",
    "test:versus-entry": "node tools/test_versus_entry_flow.cjs",
    "test:v178-sync": "node tools/test_v178_sync.cjs",
    "test:versus-room": "node tools/test_versus_room_management.cjs",
    "test:versus-rules": "node tools/versus_lab/run_scenarios.mjs",
    "test:versus-parity": "python3 tools/test_versus_rule_parity.py"
  },
  "devDependencies": {
    "vite": "^7.2.4"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "ws": "^8.21.3"
  }
}
